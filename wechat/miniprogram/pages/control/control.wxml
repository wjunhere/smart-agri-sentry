<view class="page">
  <!-- 状态条：玻璃胶囊 -->
  <view class="status-pill">
    <view class="status-left">
      <text class="conn-dot {{connected ? 'conn-ok' : 'conn-bad'}}">●</text>
      <text class="conn-text">{{connected ? 'LIVE' : 'OFFLINE'}}</text>
    </view>
    <view class="status-right">
      <text class="mono status-ip">{{carIp}}</text>
      <status-badge text="{{mode}}" type="{{mode === 'AUTO' ? 'green' : 'blue'}}" />
    </view>
  </view>

  <!-- 整栈巡航 -->
  <view class="shell">
    <view class="core">
      <text class="eyebrow">CRUISE · 整栈巡航</text>
      <view class="cruise-state">
        <text class="cruise-state-label">状态</text>
        <text class="mono cruise-state-val {{stackState === 'cruising' ? 'green' : ''}}">{{stackState}}</text>
        <text class="dim cruise-state-msg" wx:if="{{stackMessage}}">{{stackMessage}}</text>
      </view>
      <view class="cruise-btns">
        <view class="btn-ghost {{(stackState !== 'idle' && stackState !== 'error') ? 'btn-disabled' : ''}}" bindtap="onStackPreheat">预热</view>
        <view class="btn-primary {{(stackState !== 'idle' && stackState !== 'error') ? 'btn-disabled' : ''}}" bindtap="onStackStart">
          <text>{{stackState === 'preheating' || stackState === 'starting' ? '启动中…' : '启动巡航'}}</text>
        </view>
        <view class="btn-danger {{(stackState === 'stopping' || stackState === 'idle') ? 'btn-disabled' : ''}}" bindtap="onStackStop">
          <text>{{stackState === 'stopping' ? '停止中…' : '停止巡航'}}</text>
        </view>
        <view class="btn-ghost {{(!stackAlive || stackState === 'cruising' || stackState === 'preheating' || stackState === 'starting' || stackState === 'stopping') ? 'btn-disabled' : ''}}" bindtap="onStackShutdown">结束栈</view>
      </view>
    </view>
  </view>

  <!-- 手动遥控 -->
  <view class="shell">
    <view class="core core-center">
      <text class="eyebrow">MANUAL · 手动遥控</text>
      <view class="dpad">
        <view class="dpad-btn btn-up"    bindtap="onBtnUp">▲</view>
        <view class="dpad-btn btn-left"  bindtap="onBtnLeft">◀</view>
        <view class="dpad-btn btn-center">●</view>
        <view class="dpad-btn btn-right" bindtap="onBtnRight">▶</view>
        <view class="dpad-btn btn-down"  bindtap="onBtnDown">▼</view>
      </view>
      <view class="vel-readout">
        <text class="mono vel-val">{{linear}}</text><text class="vel-unit">m/s</text>
        <text class="vel-sep">·</text>
        <text class="mono vel-val">{{angular}}</text><text class="vel-unit">rad/s</text>
      </view>
    </view>
  </view>

  <!-- 作物 + 急停 -->
  <view class="duo-row">
    <view class="shell duo-flex">
      <view class="core core-center">
        <text class="eyebrow">CROP · 作物</text>
        <view class="pills">
          <text class="pill {{cropType === 'tomato' ? 'active' : ''}}" data-crop="tomato" bindtap="onSelectCrop">番茄</text>
          <text class="pill {{cropType === 'wheat' ? 'active' : ''}}" data-crop="wheat" bindtap="onSelectCrop">小麦</text>
          <text class="pill {{cropType === 'strawberry' ? 'active' : ''}}" data-crop="strawberry" bindtap="onSelectCrop">草莓</text>
        </view>
      </view>
    </view>
    <view class="shell">
      <view class="core core-center">
        <view class="estop-ring">
          <view class="estop-btn" bindtap="onBtnStop">STOP</view>
        </view>
        <text class="estop-label">紧急停止</text>
      </view>
    </view>
  </view>

  <!-- 自动巡航状态 -->
  <view class="shell">
    <view class="core">
      <text class="eyebrow">MISSION · 自动巡航</text>
      <view class="mission-row">
        <view class="mission-cell">
          <text class="mission-label">状态</text>
          <text class="mono mission-val green">● {{missionState}}</text>
        </view>
        <view class="mission-cell">
          <text class="mission-label">点位</text>
          <text class="mono mission-val">{{missionCurrentWpIdx}}/{{missionTotalWps}}</text>
        </view>
        <view class="mission-cell">
          <text class="mission-label">检测</text>
          <text class="mono mission-val">{{missionPlantsDetected}} 株</text>
        </view>
      </view>
      <view class="tags" wx:if="{{missionWaypointLabels.length}}">
        <text class="tag" wx:for="{{missionWaypointLabels}}" wx:key="*this">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 模式/航点 -->
  <view class="duo-row">
    <view class="btn-ghost duo-flex duo-btn" bindtap="onToggleMode">
      <text class="green">{{mode === 'AUTO' ? '切换 MANUAL' : '切换 AUTO'}}</text>
    </view>
    <view class="btn-ghost duo-flex duo-btn" bindtap="onOpenWaypoints">
      <text class="amber">航点编辑</text>
    </view>
  </view>

  <!-- 小车连接 -->
  <view class="shell">
    <view class="core">
      <text class="eyebrow">LINK · 小车连接</text>
      <view class="ip-row">
        <input class="ip-input" value="{{carIp}}" bindinput="onIpInput" placeholder="小车 IP" placeholder-class="ip-ph" />
        <view class="btn-ghost ip-save" bindtap="onSaveIp">保存</view>
      </view>
    </view>
  </view>
</view>

<waypoint-editor visible="{{showWaypointEditor}}" bind:close="onCloseWaypoints" />
