<view class="page">
  <view class="card row-between">
    <text class="label">当前模式</text>
    <view class="status-right">
      <text class="conn-dot {{connected ? 'conn-ok' : 'conn-bad'}}">●</text>
      <text class="mono dim" style="font-size:20rpx">{{carIp}}</text>
      <status-badge text="{{mode}}" type="{{mode === 'AUTO' ? 'green' : 'blue'}}" />
    </view>
  </view>

  <view class="card">
    <text class="card-header">整栈巡航</text>
    <view style="font-size:22rpx;margin-bottom:12rpx">
      状态 <text class="green">{{stackState}}</text>
      <text class="dim" wx:if="{{stackMessage}}"> · {{stackMessage}}</text>
    </view>
    <view style="display:flex;gap:12rpx">
      <button size="mini" bindtap="onStackPreheat"
              disabled="{{stackState !== 'idle' && stackState !== 'error'}}">预热</button>
      <button size="mini" type="primary" bindtap="onStackStart"
              loading="{{stackState === 'preheating' || stackState === 'starting'}}"
              disabled="{{stackState !== 'idle' && stackState !== 'error'}}">启动巡航</button>
      <button size="mini" type="warn" bindtap="onStackStop"
              loading="{{stackState === 'stopping'}}"
              disabled="{{stackState === 'stopping' || stackState === 'idle'}}">停止巡航</button>
    </view>
  </view>

  <view class="card" style="text-align:center">
    <view class="dpad">
      <view class="dpad-btn btn-up"    bindtap="onBtnUp">▲</view>
      <view class="dpad-btn btn-left"  bindtap="onBtnLeft">◀</view>
      <view class="dpad-btn btn-center">●</view>
      <view class="dpad-btn btn-right" bindtap="onBtnRight">▶</view>
      <view class="dpad-btn btn-down"  bindtap="onBtnDown">▼</view>
    </view>
    <view style="margin-top:12rpx">
      <text class="mono dim">v: {{linear}}  ω: {{angular}}</text>
    </view>
  </view>

  <view style="display:flex;gap:12rpx">
    <view class="card" style="flex:1;text-align:center">
      <text class="card-header">作物</text>
      <view class="pills">
        <text class="pill {{cropType === 'tomato' ? 'active' : ''}}" data-crop="tomato" bindtap="onSelectCrop">番茄</text>
        <text class="pill {{cropType === 'wheat' ? 'active' : ''}}" data-crop="wheat" bindtap="onSelectCrop">小麦</text>
        <text class="pill {{cropType === 'strawberry' ? 'active' : ''}}" data-crop="strawberry" bindtap="onSelectCrop">草莓</text>
      </view>
    </view>
    <view class="card" style="text-align:center">
      <view class="estop-btn" bindtap="onBtnStop">STOP</view>
      <text class="muted" style="font-size:18rpx">急停</text>
    </view>
  </view>

  <view class="card">
    <text class="card-header">自动巡航</text>
    <view class="row-between" style="font-size:22rpx">
      <text>状态 <text class="green">● {{missionState}}</text></text>
      <text>点位 <text class="mono">{{missionCurrentWpIdx}}/{{missionTotalWps}}</text></text>
      <text>检测 <text class="mono">{{missionPlantsDetected}}株</text></text>
    </view>
    <view class="tags" style="margin-top:12rpx">
      <text class="tag" wx:for="{{missionWaypointLabels}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <view style="display:flex;gap:12rpx">
    <view class="card" style="flex:1;text-align:center" bindtap="onToggleMode">
      <text style="font-weight:600;color:#10B981">{{mode === 'AUTO' ? '切换 MANUAL' : '切换 AUTO'}}</text>
    </view>
    <view class="card" style="flex:1;text-align:center" bindtap="onOpenWaypoints">
      <text style="font-weight:600;color:#F59E0B">📍 航点</text>
    </view>
  </view>

  <view class="card">
    <text class="card-header">小车连接</text>
    <view style="display:flex;gap:12rpx;align-items:center">
      <input class="ip-input" value="{{carIp}}" bindinput="onIpInput" placeholder="小车 IP" />
      <button size="mini" bindtap="onSaveIp">保存</button>
    </view>
  </view>
</view>

<waypoint-editor visible="{{showWaypointEditor}}" bind:close="onCloseWaypoints" />
