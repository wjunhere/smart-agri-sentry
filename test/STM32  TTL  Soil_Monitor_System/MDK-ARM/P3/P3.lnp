--cpu Cortex-M3
"p3\startup_stm32f103xb.o"
"p3\main.o"
"p3\gpio.o"
"p3\usart.o"
"p3\stm32f1xx_it.o"
"p3\stm32f1xx_hal_msp.o"
"p3\stm32f1xx_hal_gpio_ex.o"
"p3\stm32f1xx_hal_tim.o"
"p3\stm32f1xx_hal_tim_ex.o"
"p3\stm32f1xx_hal_uart.o"
"p3\stm32f1xx_hal.o"
"p3\stm32f1xx_hal_rcc.o"
"p3\stm32f1xx_hal_rcc_ex.o"
"p3\stm32f1xx_hal_gpio.o"
"p3\stm32f1xx_hal_dma.o"
"p3\stm32f1xx_hal_cortex.o"
"p3\stm32f1xx_hal_pwr.o"
"p3\stm32f1xx_hal_flash.o"
"p3\stm32f1xx_hal_flash_ex.o"
"p3\stm32f1xx_hal_exti.o"
"p3\system_stm32f1xx.o"
--library_type=microlib --strict --scatter "P3\P3.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "P3.map" -o P3\P3.axf